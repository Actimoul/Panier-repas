{
  "manifest_version": 3,
  "name": "Panier Repas",
  "version": "1.0.0",
  "description": "Remplit ton panier de courses en ligne à partir de la liste générée par Panier Repas. Choisit le meilleur rapport qualité/prix et s'arrête toujours avant le paiement.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.intermarche.com/*",
    "https://*.leclercdrive.fr/*",
    "https://*.e-leclerc.com/*",
    "https://*.carrefour.fr/*",
    "https://*.auchan.fr/*",
    "https://*.houra.fr/*",
    "https://*.coursesu.com/*",
    "https://world.openfoodfacts.org/*",
    "https://*.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Panier Repas"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.intermarche.com/*",
        "https://*.leclercdrive.fr/*",
        "https://*.e-leclerc.com/*",
        "https://*.carrefour.fr/*",
        "https://*.auchan.fr/*",
        "https://*.houra.fr/*",
        "https://*.coursesu.com/*"
      ],
      "js": [
        "sniffer.js",
        "scoring.js",
        "adapter.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  }
}